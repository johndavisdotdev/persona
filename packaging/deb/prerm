#!/bin/sh
set -e

if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
	# Stop every microVM; their supervisors run binaries this package owns.
	for f in /srv/jailer/persona-state/*.json; do
		[ -e "$f" ] || continue
		id=$(basename "$f" .json)
		/usr/libexec/persona/persona-vm stop "$id" >/dev/null 2>&1 || true
	done
	if [ -d /run/systemd/system ]; then
		systemctl stop persona-dns.service >/dev/null 2>&1 || true
		systemctl disable persona-dns.service >/dev/null 2>&1 || true
		systemctl stop persona-netns.service >/dev/null 2>&1 || true
		systemctl disable persona-netns.service >/dev/null 2>&1 || true
	fi
fi

exit 0
